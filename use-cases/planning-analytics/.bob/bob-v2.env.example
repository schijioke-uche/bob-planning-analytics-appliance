# Optional local configuration. Copy to .bob/bob-v2.env and review.
# The environment file is trusted Bash, not an untrusted data parser.
BOB2_CHAT_AUTO_APPROVE=1
BOB2_MAX_TURNS=50
BOB2_LOG_LEVEL=warn
BOB2_PRESERVE_LEGACY_ENDPOINT_OVERRIDES=0
# Patch-45 native UI accent. Set native to preserve the CLI's own palette.
BOB2_UI_ACCENT=cyan
# BOB2_BIN=/absolute/path/to/bob
# BOB2_INTERACTIVE_MODE=code
# BOB2_ASK_MODE=ask
# BOB2_CODE_MODE=code
# BOB2_ADVANCED_MODE=advance
# BOB2_RESUME_MODE=code
# Authentication is mandatory; no BOB2_AUTH_PROBE bypass.
# One-shot output uses stream-json internally, not a BOB2_OUTPUT_FORMAT override.
