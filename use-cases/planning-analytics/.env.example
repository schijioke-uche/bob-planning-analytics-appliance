# @Author: Dr. Jeffrey Chijioke-Uche, IBM Computer Scientist

#############################################################################
#         A  U  T  H  E  N  T  I  C  A  T  I  O  N
#############################################################################

# Bob Instance ID:
#
# Supported appliance classifications:
#   bob-001      = Pro Plus
#   IBM Internal = IBM Internal version
#   Trial        = Free Trial
#   Pro          = Pro Edition
#   Ultra        = Ultra Edition
BOB_INSTANCE_ID="IBM Internal"

# Inference API Key: (Team ID Not Required by default)
BOB_API_KEY=""

# Pipe API Key:
BOBSHELL_API_KEY="${BOB_API_KEY}"

# If you created Bob API KEY with Team ID, set the ID here:
# BOB_TEAM_ID=

# Optional:
# BOB_NODE_EXTRA_CA_CERTS=/absolute/path/to/enterprise-ca.pem

# Bob API endpoint:
BOB_ENDPOINT="https://api.us-east.bob.ibm.com"

# Optional Bob authentication endpoint:
BOB_AUTH_ENDPOINT="https://console-ibm-prod.verify.ibm.com"

# Optional Bob region:
BOB_REGION="us-east"


#############################################################################
#         A  P  P  L  I  A  N  C  E   *   O  B  J  E  C  T  S
#############################################################################
# Optional Planning Analytics credential environment names for pa-tool.py:
PA_TM1_AUTHORIZATION=  # complete schema-verified Authorization value
PA_TM1_USER=
PA_TM1_PASSWORD=

# Bob Included directories: [Comma separated list of directories]
export SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export PAA_DESIGN_DIR="$SCRIPT_DIR/bob-software-hub-designs"
export PAA_STORE_DIR="$SCRIPT_DIR/bob-software-hub-store"
export BOB_INCLUDED_DIRECTORY="$PAA_STORE_DIR, $PAA_DESIGN_DIR"  # Comma separated.

# Appliance Name:
export APPLIANCE_NAME="IBM Bob Planning Analytics Agent (SWA)"

# OpenShift / IBM Software Hub context:
OPENSHIFT_API_URL=
OPENSHIFT_CLUSTER_NAME=
SWA_OPERATOR_PROJECT=ibm-swh-operators
SWA_INSTANCE_PROJECT=ibm-swh-operand
SWA_TETHERED_PROJECTS=

# IBM Software Hub / CPD CLI:
CPD_CLI_VERSION=14.3.1
SOFTWARE_HUB_VERSION=5.3.x
SOFTWARE_HUB_PROFILE=
SOFTWARE_HUB_SERVICES=

# Registry strategy:
IBM_ENTITLED_REGISTRY=cp.icr.io
PRIVATE_REGISTRY=
REGISTRY_NAMESPACE=
IBM_ENTITLEMENT_KEY=
IMAGE_PULL_SECRET_NAME=ibm-entitlement-key

# Storage / platform prerequisites:
CERT_MANAGER_NAMESPACE=cert-manager
DEFAULT_STORAGE_CLASS=
BACKUP_STORAGE_CLASS=

# Optional automation paths:
GITOPS_REPO_URL=
ARGOCD_APP_NAME=



