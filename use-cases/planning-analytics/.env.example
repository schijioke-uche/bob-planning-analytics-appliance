# @Author: Dr. Jeffrey Chijioke-Uche, IBM Computer Scientist

#############################################################################
#         A  U  T  H  E  N  T  I  C  A  T  I  O  N
#############################################################################

# Bob Instance ID:
#
# Supported appliance classifications:
#   bob-001      = Pro Plus
#   IBM Internal = IBM Internal version
#   Trial        = Free Trial
#   Pro          = Pro Edition
#   Ultra        = Ultra Edition
BOB_INSTANCE_ID="IBM Internal"

# Inference API Key: (Team ID Not Required by default)
BOB_API_KEY=""

# Pipe API Key:
BOBSHELL_API_KEY="${BOB_API_KEY}"

# If you created Bob API KEY with Team ID, set the ID here:
# BOB_TEAM_ID=

# Optional:
# BOB_NODE_EXTRA_CA_CERTS=/absolute/path/to/enterprise-ca.pem

# Bob API endpoint:
BOB_ENDPOINT="https://api.us-east.bob.ibm.com"

# Optional Bob authentication endpoint:
BOB_AUTH_ENDPOINT="https://console-ibm-prod.verify.ibm.com"

# Optional Bob region:
BOB_REGION="us-east"


#############################################################################
#         A  P  P  L  I  A  N  C  E   *   O  B  J  E  C  T  S
#############################################################################
# Optional Planning Analytics credential environment names for pa-tool.py:
PA_TM1_AUTHORIZATION=  # complete schema-verified Authorization value
PA_TM1_USER=
PA_TM1_PASSWORD=

# Bob Included directories: [Comma separated list of directories]
export SCRIPT_DIR="$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)"
export PAA_DESIGN_DIR="$SCRIPT_DIR/bob-planning-analytics-designs"
export PAA_STORE_DIR="$SCRIPT_DIR/bob-planning-analytics-store"
export BOB_INCLUDED_DIRECTORY="$PAA_STORE_DIR, $PAA_DESIGN_DIR"  # Comma separated.

# Appliance Name:
export APPLIANCE_NAME="IBM Bob Planning Analytics Appliance (PAA)"

# OpenShift / IBM Software Hub context:
OPENSHIFT_API_URL=
OPENSHIFT_CLUSTER_NAME=
SWA_OPERATOR_PROJECT=ibm-swh-operators
SWA_INSTANCE_PROJECT=ibm-swh-operand
SWA_TETHERED_PROJECTS=

# IBM Software Hub / CPD CLI:
CPD_CLI_VERSION=14.3.1
SOFTWARE_HUB_VERSION=5.3.x
SOFTWARE_HUB_PROFILE=
SOFTWARE_HUB_SERVICES=

# Registry strategy:
IBM_ENTITLED_REGISTRY=cp.icr.io
PRIVATE_REGISTRY=
REGISTRY_NAMESPACE=
IBM_ENTITLEMENT_KEY=
IMAGE_PULL_SECRET_NAME=ibm-entitlement-key

# Storage / platform prerequisites:
CERT_MANAGER_NAMESPACE=cert-manager
DEFAULT_STORAGE_CLASS=
BACKUP_STORAGE_CLASS=

# Optional automation paths:
GITOPS_REPO_URL=
ARGOCD_APP_NAME=




#############################################################################
#   P L A N N I N G   A N A L Y T I C S   S A a S   (AWS)  —  A U T H
#############################################################################

# AWS region slug — taken from the first segment of your PA SaaS URL.
# Example URL:  https://us-east-1.planninganalytics.saas.ibm.com/api/<tenantID>/v0/...
# The region slug is the part before .planninganalytics.saas.ibm.com
# Examples: us-east-1 | eu-west-2 | ap-southeast-1 | ap-south-1
PA_SAAS_REGION=us-east-1

# PA Account ID and Tenant ID (from your PA subscription home URL):
# Subscription URL: https://${PA_SAAS_REGION}.planninganalytics.saas.ibm.com/?accountId=${PA_ACCOUNT_ID}&tenantId=${PA_TENANT_ID}&perspective=pa-home
PA_ACCOUNT_ID=
PA_TENANT_ID=

# PA SaaS API root — the base URL up to and including the tenant/version segment.
# Evaluated dynamically using ${PA_TENANT_ID}:
#   Full URL:    https://us-east-1.planninganalytics.saas.ibm.com/api/${PA_TENANT_ID}/v0/rolemgmt/v1/users/me
# The TM1 REST database endpoint appends:  /tm1/api/<dbname>/api/v1
PA_API_ROOT="https://us-east-1.planninganalytics.saas.ibm.com/api/\${PA_TENANT_ID}/v0"

# IBM SaaS API key for the automation user.
# Create in: IBM SaaS Console → Administration → Access (IAM) → Personal Access Keys
# The key value is shown ONCE — save immediately in a secrets manager.
# Minimum user roles: Environment Analyst + Database Read.
PA_API_KEY=

# Keep false to require Planning Analytics connection verification.
PA_SKIP_PROBE="false"

# Total timeout for each request, in seconds.
PA_CURL_TIMEOUT="30"

# Color: auto, always, or never.
PA_COLOR="auto"

# Optional approved PEM CA bundle for corporate certificate environments.
PA_CA_BUNDLE=""

# Allow open permissions on .env (set true if appliance tree is chmod 0777)
PA_ALLOW_OPEN_ENV_MODE="false"

# Path to Planning Analytics SaaS Auth script (optional override):
PA_AUTH_SCRIPT=""


#################################################################################
#   W A T S O N X   O R C H E S T R A T E   ->   O N  S A A S  (AWS) 
#   Reuses the wxc objects
##################################################################################

# Orchestrate instance ID, region slug and environment type (placeholders only):
# Environment type:  aws | azure | ibm_cloud
WXO_INSTANCES_ID=
WXO_REGION=
ENVIRONMENT=

# Orchestrate instance URL (from Orchestrate: Settings -> API details).
# Example shape only: https://api.<region>.watson-orchestrate.cloud.ibm.com/instances/<instance-id>
WXO_API_URL=

# Orchestrate API key (separate from PA_API_KEY; never reuse one for the other).
# Only needed for "apply"/"rollback" unless WXO_SKIP_ACTIVATE=true.
WXO_API_KEY=

# Local Orchestrate ADK environment name and type (mcsp = IBM Cloud/AWS SaaS).
WXO_ENV_NAME="pa-saas-${ENVIRONMENT}"
WXO_ENV_TYPE="mcsp"

# URL of an MCP server that fronts PA SaaS. REQUIRED. This script does not create
# it, and no IBM-hosted PA MCP URL has been confirmed.
WXO_MCP_SERVER_URL=

# streamable_http (handshake probe supported) or sse (probe skipped).
WXO_MCP_TRANSPORT="streamable_http"

# Toolkit name in Orchestrate, tools to expose (* or comma-separated names).
WXO_MCP_TOOLKIT_NAME=""
WXO_MCP_TOOLS="*"

# true = create the app-id if absent; false = it must already exist.
WXO_MCP_CONN_CREATE="true"

# Optional Orchestrate connection app-id for the MCP server. When set, "apply"
# creates it if absent: API key auth, team-level, configured for draft AND live.
# Existing connections, configurations and credentials are never modified.
WXO_MCP_APP_ID=

# API key Orchestrate presents to YOUR MCP server. NOT PA_API_KEY and NOT
# WXO_API_KEY. No whitespace. Same key is used for draft and live. Leave empty to
# set credentials in Orchestrate yourself.
WXO_MCP_CONN_API_KEY=""

# Optional custom header name for that key (for example X-Api-Key). If empty the
# ADK's default is used; set it if your MCP server expects a specific header.
WXO_MCP_CONN_HEADER_NAME=""

# true = you already ran "orchestrate env activate"; false = script activates.
WXO_SKIP_ACTIVATE="false"

# true skips the PA SaaS auth preflight (PA access then NOT verified).
WXO_SKIP_PA_PREFLIGHT="false"

# ADK isolation (all optional; defaults shown). The ADK is installed in a dedicated
# venv and uses its own HOME, so your personal "orchestrate" environments and
# credentials are never read or changed. Absolute paths only; HOME itself is refused.
WXO_ADK_VERSION="2.18.1"
WXO_PYTHON=""                 # python 3.11-3.14 with venv; auto-detected if empty
WXO_VENV_DIR=""               # default: <script dir>/.venv-adk
WXO_ADK_HOME=""               # default: <script dir>/.adk-home


#################################################################################
#   P L A N N I N G   A N A L Y T I C S   M C P   S E R V E R   ( S T D I O / H T T P )
#################################################################################

# Planning Analytics Native MCP Endpoint (optional override, defaults to ${PA_API_ROOT}/mcp):
PA_MCP_URL=""

# Authentication scheme used when calling PA MCP endpoint (auto | basic | bearer):
PA_MCP_AUTH_MODE="auto"

# MCP Server network bind host, port, and transport mode (stdio | http):
PA_MCP_SERVER_HOST="0.0.0.0"
PA_MCP_SERVER_PORT="8080"
PA_MCP_SERVER_TRANSPORT="stdio"

#################################################################################################
#   P L A N N I N G   A N A L Y T I C S   W A T S O N X AI I N T E G R A T I O N  O B J E C T S
#################################################################################################
WATSONX_API_URL=
WATSONX_API_KEY=
WATSONX_API_PROJECT_ID=


#################################################################################################
#   P L A N N I N G   A N A L Y T I C S   W A T S O N X  I N T E G R A T I O N  O B J E C T S
#################################################################################################
# Multi-line / JSON values: keep each on ONE line so the file parses the same in
# bash, docker --env-file and python-dotenv. Never put real values in this example.

# IBM watsonx Orchestrate instance details, compact one-line JSON in SINGLE quotes
# (no single quote may appear inside; no ${VAR} references - single quotes do not expand).
# Shape: {"hostURL":"...","orchestrationID":"...","agentId":"...","agentEnvironmentId":"...","perspectives":["..."],"purchaseID":"..."}
WXO_INSTANCE_JSON_STRING=''

# IBM watsonx Orchestrate embedded chat key (PEM key) on ONE line in DOUBLE
# quotes, with line breaks written as the two characters \n:
#   "-----BEGIN <TYPE>-----\n<base64 line>\n...\n-----END <TYPE>-----"
# Consumers must convert \n back to a newline (bash: printf '%b' "$WXO_EMBEDDED_CHAT_KEY";
# python: value.replace("\\n", "\n")). Plain bash 'source' leaves \n literal.
WXO_EMBEDDED_CHAT_KEY=""

# Modeler Proider: default | watsonx.ai | aws_bedrock
MODELER_PROVIDER='default'

# IBM watsonx API details, compact one-line JSON in SINGLE quotes.
# Shape: {"watsonx_api_url":"...","watsonx_api_key":"...","watsonx_api_project_id":"..."}
# See: https://dataplatform.cloud.ibm.com/wx/home?context=wx
WATSONX_API_JSON_STRING=''


#################################################################################
#   P L A N N I N G   A N A L Y T I C S   T M 1   R E S T   &   C U B E S
#   (pa-cubes & pa_cubes_v2 Metadata Exporters)
#################################################################################

# Target TM1 Database Name (the TM1 REST endpoint is auto-constructed:
#   ${PA_API_ROOT}/tm1/${PA_DATABASE_NAME}/api/v1):
PA_DATABASE_NAME=""

# Authentication Mode: APIKEY | CAM | BASIC | BEARER (Default: APIKEY)
PA_AUTH_MODE="APIKEY"

# APIKEY mode (Default: Planning Analytics as a Service WITH MCSP):
# Reuses the standard PA_API_KEY, PA_API_ROOT, and PA_TENANT_ID defined above.
# The rolemgmt identity endpoint is derived directly: ${PA_API_ROOT}/rolemgmt/v1/users/me

# CAM / Basic non-interactive credentials (used when PA_AUTH_MODE=CAM or BASIC):
# Reuses the standard PA_TM1_USER and PA_TM1_PASSWORD defined above.
PA_NAMESPACE=""

# BEARER / Pre-authenticated header mode (used when PA_AUTH_MODE=BEARER):
# Reuses the standard PA_TM1_AUTHORIZATION header defined above.

# Output directory for exported files (defaults to store/cubes under pa_cubes_v2/):
# Subdirectories created automatically: store/cubes/excel and store/cubes/pdf
PA_OUTPUT_DIR=""
PA_INCLUDE_CONTROL_CUBES="1"

# Transport limits and bounded API resilience:
PA_USE_ENV_PROXY="0"
PA_CONNECT_TIMEOUT="10"
PA_TIMEOUT="60"
PA_RETRIES="3"
PA_BACKOFF="1"
PA_MAX_RETRY_WAIT="60"
PA_PAGE_SIZE="1000"
PA_MAX_PAGES="1000"
PA_MAX_ROWS="250000"
PA_MAX_REQUESTS="20000"
PA_MAX_RESPONSE_MB="32"

# Query scope & options:
PA_ATTRIBUTES="both"          # definitions | values | both (Option 5)
PA_VIEW_SCOPE="public"        # public | private | both (Option 7/8)

# Option 8 cell query parameters (single preconfigured view or MDX file):
PA_DATA_CUBE=""
PA_DATA_VIEW=""
# PA_MDX_FILE=""
PA_MAX_CELLS="1000"

# Local testing only; HTTP accepted only for loopback IP addresses:
PA_ALLOW_HTTP="0"

# Python runtime and dedicated Virtual Environment for pa-cubes / pa_cubes_v2:
PA_PYTHON=""
PA_CUBES_VENV_DIR=""